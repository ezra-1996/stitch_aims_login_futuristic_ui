{
  "info": {
    "name": "AIMS Unit Tests",
    "description": "API Unit testing for AIMS backend (Authentication, Face Verification, Report Evaluation) replicating Chapter 4.5.1 test results.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Passed: Authentication API Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Passed: Returns valid JWT access token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('access');",
              "    pm.environment.set(\"access_token\", jsonData.access);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"student_1\",\n    \"password\": \"student123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        }
      }
    },
    {
      "name": "2. Face Verification API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Passed: Face Verification Server Responded (200/201)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test(\"Passed: Processing Logic executed correctly\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.not.be.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": []
            },
            {
              "key": "latitude",
              "value": "40.7128",
              "type": "text"
            },
            {
              "key": "longitude",
              "value": "-74.0060",
              "type": "text"
            },
            {
              "key": "student_id",
              "value": "UNI-2026-001",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/attendance/mark-ai/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "attendance",
            "mark-ai",
            ""
          ]
        }
      }
    },
    {
      "name": "3. Fetch Student Reports",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Passed: Fetched reports successfully\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "if (jsonData.length > 0) {",
              "    pm.environment.set(\"report_id\", jsonData[0].report_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/evaluation/weekly-reports/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "evaluation",
            "weekly-reports",
            ""
          ]
        }
      }
    },
    {
      "name": "4. Report Evaluation API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Passed: Report Evaluation responded successfully\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/evaluation/weekly-reports/{{report_id}}/evaluate/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "evaluation",
            "weekly-reports",
            "{{report_id}}",
            "evaluate",
            ""
          ]
        }
      }
    }
  ]
}
